```{=html}

<%
// Number of columns
const cols = 3;

// Card alignment
const align = "left";

// Borders
const hideBorders = false;

// Cap Options
const imgHeight = "100%";

// Quarto emits an HTML-comment placeholder (invisible but non-empty) when a
// field like description can't be read from the source file; strip HTML
// before checking for real, visible content.
const hasText = (v) => {
  if (v == null) return false;
  const stripped = String(v).replace(/<!--[\s\S]*?-->/g, '').replace(/<[^>]*>/g, '').trim();
  return stripped.length > 0;
};
const stripHtml = (v) => String(v).replace(/<!--[\s\S]*?-->/g, '').replace(/<[^>]*>/g, '').trim();
%>

<style>
  .quarto-grid-item.card {
    position: relative;
  }
  .quarto-grid-item .card-img-top {
    overflow: hidden;
  }
  .quarto-grid-item .thumbnail-image {
    transition: transform 0.25s ease-in-out;
  }
  .quarto-grid-item:hover .thumbnail-image {
    transform: scale(1.05);
  }
  .quarto-grid-item .listing-categories .listing-category .listing-href {
    position: relative;
    z-index: 2;
    color: inherit; /* normal text color, not the href color: not enough contrast on cards */
    text-decoration: none;
  }
  /* .card-body has overflow:auto (Bootstrap default), which clips a
     .stretched-link nested inside it before it can cover the image area
     above. Use a dedicated overlay link as a direct child of .card instead,
     outside of any clipping ancestor, so the whole card is clickable. */
  .quarto-grid-item .card-click-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>

<div class="list grid quarto-listing-cols-<%=cols%>">
<% for (const item of items) { %>
  <div class="g-col-1" <%= metadataAttrs(item) %>>
    <div class="quarto-grid-item card h-100 <%-`card-${align}`%><%= hideBorders ? ' borderless' : '' %>">
      <% if (item.image) { %>
        <p class="card-img-top">
          <img src="<%= item.image %>" class="thumbnail-image card-img" style="height: auto;" alt="<%= item['image-alt'] %>">
        </p>
      <% } else { %>
        <div class="card-img-bg" <%= imgHeight ? ` style="height: ${imgHeight};"` : '' %>>&nbsp;</div>
      <% } %>
      <% if (hasText(item.title) || hasText(item.subtitle) || hasText(item.description) || hasText(item.author) || hasText(item.date) || hasText(item.since) || otherFields.length > 0) { %>
        <div class="card-body post-contents">
          <% if (hasText(item.title)) { %><h5 class="no-anchor card-title listing-title"><%= item.title %></h5><% } %>
          <% if (hasText(item.subtitle)) { %><div class="card-subtitle listing-subtitle"><%= item.subtitle %></div><% } %>

          <% if (hasText(item.description)) { %>
            <div class="card-text listing-description delink"><%= item.description %></div>
          <% } %>

          <%
          const flexJustify = hasText(item.author) && (hasText(item.since) || hasText(item.date)) ? "justify" : hasText(item.author) ? "start" : "end";
          %>
          <% if (hasText(item.author) || hasText(item.since) || hasText(item.date)) { %>
            <div class="card-attribution card-text-small <%-flexJustify%>">
              <% if (hasText(item.author)) { %><div class="listing-author"><%= item.author %></div><% } %>
              <% if (hasText(item.since)) { %>
                <div class="listing-date"><%= item.since %>–<%= hasText(item.end) ? item.end : 'present' %></div>
              <% } else if (hasText(item.date)) { %>
                <div class="listing-date"><%= item.date %></div>
              <% } %>
            </div>
          <% } %>
          <div class="listing-categories" style="padding-top: 1em;">
            <% if (hasText(item.github)) { %>
              <div class="listing-category">
                <a class="listing-href" href="<%= item.github %>" target="_blank" rel="noopener">Github <i class="fa-brands fa-github"></i></a>
              </div>
            <% } %>
            <% if (hasText(item.website)) { %>
              <div class="listing-category">
                <a class="listing-href" href="<%= item.website %>" target="_blank" rel="noopener">Website <i class="fa-brands fa-firefox-browser"></i></a>
              </div>
            <% }  %>
          </div>
        </div>
      <% } %>

      <!-- <div class="card-footer">
          <div class="card-filename listing-filename">
            <%= item.filename ? item.filename : "&nbsp;" %>
          </div>
          <div class="card-file-modified listing-file-modified">
            <%= item['file-modified'] ? item['file-modified'] : "&nbsp;"%>
          </div>
      </div> -->

      <% if (hasText(item.website)) { %>
        <a class="card-click-overlay" href="<%= item.website %>" target="_blank" rel="noopener" aria-label="<%= stripHtml(item.title) %>"></a>
      <% } %>

    </div>
  </div>
<% } %>
</div>


```
